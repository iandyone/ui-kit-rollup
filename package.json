{
  "name": "ui-kit-rollup",
  "version": "1.0.0",
  "description": "React components UI Library",
  "license": "UNLICENSED",
  "author": "iandyone",
  "repository": {
    "type": "git",
    "url": "https://github.com/iandyone/ui-kit-rollup"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build:js": "rollup --config",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:js && npm run build:types",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project=storybook --coverage",
    "lint": "eslint ./src",
    "prepack": "npm run build"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.62.3",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.5.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    "./styles.css": "./dist/assets/styles.css",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./button": {
      "types": "./dist/types/button/index.d.ts",
      "import": "./dist/es/button/index.js",
      "require": "./dist/cjs/button/index.cjs"
    },
    "./input": {
      "types": "./dist/types/input/index.d.ts",
      "import": "./dist/es/input/index.js",
      "require": "./dist/cjs/input/index.cjs"
    },
    "./typography": {
      "types": "./dist/types/typography/index.d.ts",
      "import": "./dist/es/typography/index.js",
      "require": "./dist/cjs/typography/index.cjs"
    }
  }
}
